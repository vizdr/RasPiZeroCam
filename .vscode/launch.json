{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Remote Debug Pi Zero 2 W",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/pizero2cam_app",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerServerAddress": "192.168.178.55:2345",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set sysroot for symbols",
                    "text": "-gdb-set sysroot ~/rpi-sysroot",
                    "ignoreFailures": true
                },
                {
                    "description": "ARM64 disassembly",
                    "text": "-gdb-set disassembly-flavor att",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "start-gdb-server",
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "sourceFileMap": {
                "/home/vladimir/projects/Raspi-Z2-Cam/camera_controller": "${workspaceFolder}"
            }
        }
    ]
}