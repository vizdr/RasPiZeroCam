{
    "configurations": [
        {
            "name": "Cross-Compile Camera aarch64 (Pi Zero 2 W)",
            "compileCommands": "${workspaceFolder}/build/debug/compile_commands.json",
            "compilerPath": "/usr/bin/aarch64-linux-gnu-g++",
            "compilerArgs": [
                "--sysroot=${env:HOME}/rpi-sysroot",
                "-march=armv8-a",
                "-mtune=cortex-a53"
            ],
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/third_party",
                "/usr/aarch64-linux-gnu/include/c++/13",
                "/usr/aarch64-linux-gnu/include/c++/13/aarch64-linux-gnu",
                "/usr/aarch64-linux-gnu/include/c++/13/backward",
                "/usr/lib/gcc-cross/aarch64-linux-gnu/13/include",
                "${env:HOME}/rpi-sysroot/usr/include",
                "${env:HOME}/rpi-sysroot/usr/include/aarch64-linux-gnu",
                "${env:HOME}/rpi-sysroot/usr/include/libcamera",
                "${env:HOME}/rpi-sysroot/usr/include/gstreamer-1.0",
                "${env:HOME}/rpi-sysroot/usr/include/glib-2.0",
                "${env:HOME}/rpi-sysroot/usr/lib/aarch64-linux-gnu/glib-2.0/include",
                "${env:HOME}/rpi-sysroot/usr/include/sysprof-6",
                "${env:HOME}/rpi-sysroot/usr/local/include"
            ],
            "defines": [
                "__aarch64__",
                "__ARM_ARCH=8",
                "DEBUG=1",
                "HAVE_LIBCAMERA=1"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-arm64"
        }
    ],
    "version": 4
}
